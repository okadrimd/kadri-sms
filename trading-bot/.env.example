# Alpaca PAPER trading credentials (https://app.alpaca.markets -> Paper account)
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret_key

# --- daily_report.py: end-of-day Telegram summary --------------------------
# Additional paper accounts to include in the close report (optional).
ALPACA_ACCOUNT_NAME_1=Swing Bot
#ALPACA_API_KEY_2=
#ALPACA_SECRET_KEY_2=
#ALPACA_ACCOUNT_NAME_2=
#ALPACA_API_KEY_3=
#ALPACA_SECRET_KEY_3=
#ALPACA_ACCOUNT_NAME_3=

# Telegram bot delivery (from @BotFather; chat id via /getUpdates)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# --- nine_sig.py: automated 9sig bot ---------------------------------------
# Use a SEPARATE paper account from the swing bot. Falls back to the main
# ALPACA keys above if unset (fine for a first shadow-mode test).
#NINE_SIG_ALPACA_API_KEY=
#NINE_SIG_ALPACA_SECRET_KEY=
# "shadow" (default) logs intended orders and places nothing; "paper" trades.
NINE_SIG_MODE=shadow
# Set to 0 to disable the 200-day regime overlay (leave at 1 — it's the point).
NINE_SIG_REGIME=1
